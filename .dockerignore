# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Local data & model caches (can be 20+ GB — never send to Docker daemon) ──
.data/
data/
.cache/
root/.cache/
**/huggingface/
**/docling/
.models/

# ── Git ──────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Build artefacts ──────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# ── Logs & secrets ───────────────────────────────────────────────────────────
*.log
*.pid
.env.local
.env.*.local

# ── Frontend (not needed for backend image) ──────────────────────────────────
ui/
node_modules/

# ── Docs / CI (not needed at runtime) ───────────────────────────────────────
README.md
COMPLETION_SUMMARY.md
QUICKSTART.sh
*.md
